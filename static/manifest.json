{
  "manifest_version": 3,
  "name": "Odoo Debug",
  "version": "2.1.0",
  "description": "In-page panel for Odoo developers: record, view & action, RPC log, ORM console, access rights, security, server profiler.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Odoo Debug",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Show / hide the panel"
    },
    "popout-panel": {
      "description": "Open the panel in its own window"
    },
    "toggle-debug": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Debug mode on / off"
    }
  },
  "permissions": [
    "scripting",
    "cookies",
    "storage",
    "clipboardWrite",
    "downloads",
    "declarativeContent"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rpc-recorder.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rpc-relay.js",
        "launcher.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/index.html",
        "icons/icon-48.png"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "popup/index.html",
    "open_in_tab": false
  }
}
