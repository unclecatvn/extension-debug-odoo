{
  // node: build scripts (scripts/) and tests (tests/), run by Node as .ts. DOM types only for the declarations of what tests import.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "chrome"],
    "declarationDir": ".tsbuild/node",
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo"
  },
  "include": ["scripts", "tests"],
  "exclude": [],
  "references": [{ "path": "./tsconfig.contracts.json" }, { "path": "./tsconfig.content.json" }, { "path": "./tsconfig.app.json" }]
}
